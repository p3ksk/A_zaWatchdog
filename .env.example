# MariaDB passwords used by docker-compose.yml
MARIADB_ROOT_PASSWORD=rootpw
MARIADB_PASSWORD=watchpw

# SMTP account for price notification emails. Leave SMTP_HOST empty to send none.
SMTP_HOST=
SMTP_PORT=587
# Login to the mail account, and the address mail is sent from.
SMTP_USER=watchdog@example.com
SMTP_PASSWORD=

# Public origin, used for the links inside those emails.
PUBLIC_URL=https://watchdog.example.com
